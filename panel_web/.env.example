# =============================================================================
# Panel web público — copia a .env y rellena en el servidor (nunca en el repo)
# =============================================================================
APP_ENV=production
APP_NAME=Separador de PDFs
APP_TIMEZONE=America/Mexico_City
DOMAIN=pdf-separator.duckdns.org
ALLOWED_HOSTS=pdf-separator.duckdns.org,localhost,127.0.0.1

# --- Microsoft Entra ID ------------------------------------------------------
# Directorio (tenant) ID y Application (client) ID de la app registrada.
MS_TENANT_ID=
MS_CLIENT_ID=
# Valor del secreto creado en "Certificates & secrets". No lo pegues en el chat.
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://pdf-separator.duckdns.org/auth/callback

# Opcional. Solo para tenant External ID (CIAM) o nube soberana.
# Ejemplo CIAM: https://<subdominio>.ciamlogin.com/<tenant-id>/v2.0
MS_AUTHORITY=

# Restringe el acceso. Usa ALLOWED_DOMAIN o ALLOWED_EMAILS (o ambos).
ALLOWED_DOMAIN=tuempresa.com
ALLOWED_EMAILS=
# Los administradores no tienen más pantallas en esta versión; el panel clásico
# sigue siendo la consola de administración por túnel SSH.
ADMIN_EMAILS=

# --- Sesión / cookies --------------------------------------------------------
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=
COOKIE_SECURE=true
SESSION_MAX_AGE=28800

# --- Límites -----------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PAGES=500
MAX_PAGES_PER_DAY=500
MAX_QUEUED_JOBS=3
MAX_UPLOADS_PER_HOUR=10
MAX_USERS=5

# --- Pipeline ----------------------------------------------------------------
OCR_WORKERS=2
JOB_TIMEOUT_SECONDS=7200
AVG_SECONDS_PER_PAGE=12
RETENTION_DAYS=30

# --- Rutas dentro del contenedor --------------------------------------------
DATA_DIR=/data
SEPARATOR_CODE_DIR=/separador_pdfs
INVENTORY_DIR=/data/inventarios

# --- Caddy / Let's Encrypt ---------------------------------------------------
ACME_EMAIL=admin@tuempresa.com
