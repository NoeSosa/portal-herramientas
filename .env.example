# =============================================================================
# Portal de Herramientas — variables de entorno
# =============================================================================
# Copia este archivo a `.env` y rellena los valores reales:
#     cp .env.example .env && chmod 600 .env
#
# ⚠️ NUNCA subas `.env` al repositorio. Está en .gitignore.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
# Sin comillas: `env_file` de Docker las pasa literales y el nombre aparecería
# con ellas en /api/info.
APP_NAME=Portal de Herramientas
APP_ENV=production
LOG_LEVEL=INFO

# --- Puertos ----------------------------------------------------------------
# Solo se publica el frontend, y SOLO en loopback del host.
# El acceso real es por túnel SSH:
#     ssh -L 8080:127.0.0.1:8080 -i mi-llave.key ubuntu@<servidor>
#     → luego abrir http://localhost:8080
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# --- Límites de subida ------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=500
JOB_TIMEOUT_SECONDS=1800

# --- Redis (interno, no se publica) -----------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Rutas de datos (volúmenes) ---------------------------------------------
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs

# --- Claves de API de las herramientas --------------------------------------
# Gemini: visión de imágenes, transcripción de audio, comprobantes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Rutas a los scripts y venv existentes del workspace de OpenClaw.
HERRAMIENTAS_SCRIPTS_DIR=/home/node/.openclaw/workspace/scripts
OCR_LD_LIBRARY_PATH=/opt/lib

# --- Correo (solo lectura / avisos; desactivado por defecto) -----------------
# Deja vacío para no exponer envío de correo desde la web.
GMAIL_USER=
GMAIL_APP_PASSWORD=
