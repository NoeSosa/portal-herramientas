# =============================================================================
# Worker OCR — Separador de PDFs
# =============================================================================
# Imagen pesada con PaddleOCR + OpenCV + PyMuPDF para el OCR de contadores.
#
# ⚠️ ARM64: la instalación es frágil. Reglas que NO se deben cambiar sin volver
# a validar (ver docs/OCR.md y la skill `stack-ocr-arm64`):
#   1. PaddleOCR 2.7.0.3 exige PyMuPDF<1.21 pero no hay wheel útil en aarch64
#      → se instala con --no-deps y se usa PyMuPDF 1.26.0 (compatible).
#   2. Nunca compilar desde fuente: solo wheels manylinux2014_aarch64.
#   3. libgomp.so.1 es obligatorio (sin OpenMP, paddle no importa).
#   4. numpy 2.x eliminó np.sctypes y rompe imgaug → parche en runtime.
# =============================================================================

FROM debian:bookworm-slim

# ⚠️ BASE = debian + python3 del sistema (NO `python:3.11-slim`).
# Motivo: el worker OCR comparte la cola pesada con la transcripción, y esta
# última ejecuta scripts del workspace de OpenClaw con SU venv. Los venv llevan
# rutas horneadas (`home = /usr/bin`, `executable = /usr/bin/python3.11`), y las
# imágenes `python:*` instalan en /usr/local/bin con su propio stdlib: el venv
# montado acabaría cargando media stdlib de la imagen y fallando con
# `ModuleNotFoundError: No module named '_csv'` / `'_posixsubprocess'`.
# Con debian + `apt install python3`, /usr/lib/python3.11 está completo y el
# venv de OpenClaw funciona tal cual. Igual que el Dockerfile del backend.
ENV DEBIAN_FRONTEND=noninteractive

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # libgomp debe estar en el path de carga para el motor de paddle.
    LD_LIBRARY_PATH=/opt/lib

# Dependencias de sistema:
#   - libgomp1        → OpenMP, requerido por paddlepaddle.
#   - libglib2.0-0    → OpenCV (aunque sea headless, glib hace falta).
#   - libgl1          → OpenCV.
#   - libsm6/libxext6 → OpenCV.
#   - fonts-dejavu    → render de texto en el reporte.
#   - unzip/tzdata    → utilidades y zona horaria correcta.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-venv \
      python3-pip \
      libgomp1 \
      libglib2.0-0 \
      libgl1 \
      libsm6 \
      libxext6 \
      libxrender1 \
      fonts-dejavu-core \
      unzip \
      tzdata \
 && rm -rf /var/lib/apt/lists/*

# Copia explícita de libgomp a la ruta que espera LD_LIBRARY_PATH.
# Evita depender de que el loader la encuentre por sí solo.
RUN mkdir -p /opt/lib \
 && find /usr/lib -name 'libgomp.so.1*' -exec cp -av {} /opt/lib/ \; 2>/dev/null || true \
 && ldconfig

# El intérprete del sistema queda en /usr/bin/python3, que es exactamente lo que
# espera el venv de OpenClaw (`pyvenv.cfg` → `home = /usr/bin`). No hace falta
# ningún enlace de compatibilidad.
RUN /usr/bin/python3 -V

WORKDIR /app

# --- Dependencias base de la aplicación ------------------------------------
# El worker OCR también necesita la infraestructura común: redis y rq para
# consumir la cola, pydantic-settings para la configuración.
# Sin esto el worker arranca y muere con "No module named 'redis'".
COPY requirements.txt .

RUN python3 -m pip install --break-system-packages --upgrade pip setuptools wheel \
 && python3 -m pip install --break-system-packages -r requirements.txt

# --- Dependencias de OCR ---------------------------------------------------
# Se instalan en capas separadas para aprovechar la caché: paddle y paddleocr
# son los pasos lentos y cambian rara vez.
COPY requirements-ocr.txt .

RUN python3 -m pip install --break-system-packages --upgrade pip setuptools wheel \
 # 1. PyMuPDF: versión con wheel aarch64 validada. Otra intenta compilar mupdf.
 && python3 -m pip install --break-system-packages "PyMuPDF==1.26.0" \
 # 2. paddlepaddle: wheel oficial aarch64.
 && python3 -m pip install --break-system-packages "paddlepaddle==2.6.2" \
 # 3. Dependencias de paddleocr que hay que fijar manualmente.
 && python3 -m pip install --break-system-packages \
      shapely \
      pyclipper \
      lmdb \
      tqdm \
      premailer \
      scikit-image \
      rapidfuzz \
      python-docx \
      beautifulsoup4 \
      lxml \
      openpyxl \
      imgaug \
 # 4. paddleocr SIN dependencias: su pin de PyMuPDF<1.21 no tiene wheel útil.
 && python3 -m pip install --break-system-packages --no-deps "paddleocr==2.7.0.3" \
 # 5. Resto de dependencias del separador.
 && python3 -m pip install --break-system-packages pandas opencv-python-headless requests

# --- Código de la aplicación ----------------------------------------------
COPY --chown=1000:1000 app/ ./app/

# --- Motor del separador (horneado, no por volumen) -----------------------
# Se incluye en la imagen en vez de montarlo: así el worker OCR es
# autocontenido y no depende de que exista un camino en el host.
COPY --chown=1000:1000 separador/ /separador/

# --- Usuario sin privilegios ----------------------------------------------
# uid/gid 1000: es el dueño del volumen de OpenClaw (drwx------ de 1000).
# Con otro uid el contenedor no puede leer /home/node/.openclaw.
RUN groupadd --gid 1000 portal \
 && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin portal \
 && mkdir -p /data/uploads /data/outputs \
 && chown -R portal:portal /data /separador

USER portal

# Directorio de modelos de PaddleOCR (se descargan en la primera ejecución).
ENV HOME=/home/portal

# El worker-ocr no expone puertos: solo consume de la cola `pesada`.
CMD ["python", "-m", "app.worker"]
